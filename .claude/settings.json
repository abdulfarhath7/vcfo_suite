{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run check)",
      "Bash(npx vitest run *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "codebase-cleanup@codebase-cleanup": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "codebase-cleanup": {
      "source": {
        "source": "github",
        "repo": "CRangelP/codebase-cleanup"
      }
    }
  }
}
