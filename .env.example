# =====================================================================
# VCFO Suite — environment configuration
# Copy this file to `.env.local` and fill in.  The values below are the
# LOCAL (laptop / office-server) defaults that match docker-compose.yml.
# Comments show what changes when you move to AWS.
# =====================================================================

# ---------- Database (Postgres) ----------
# LOCAL: points at the Postgres container from docker-compose.yml
# AWS:   swap host/creds for your RDS endpoint, keep ?sslmode=require
DATABASE_URL="postgresql://vcfo:vcfo_local_dev@localhost:5432/vcfo"

# ---------- Auth.js (NextAuth) ----------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
# LOCAL: your machine. For office-server / phone / Cloudflare quick tunnel:
#   1) Leave AUTH_URL unset (AUTH_TRUST_HOST=true). Auth.js rewrites the request
#      origin to AUTH_URL when it is set (next-auth `reqWithEnvURL`), so pinning
#      http://localhost:3000 or a *.trycloudflare.com URL breaks the other host.
#      Quick tunnel hostnames also rotate every `cloudflared` run.
#   2) Use `npm run dev:lan` (or `npm run build && npm run start:lan`)
#   3) Optional: ALLOWED_DEV_ORIGINS / DEV_TUNNEL_HOST for next.config allow-list
# AWS:   https://app.yourdomain.com
# AUTH_URL="http://192.168.1.50:3000"
AUTH_TRUST_HOST="true"
# Extra hosts for `next dev` `/_next/*` (LAN IP, ngrok, or a full URL).
# Cloudflare quick tunnels (`*.trycloudflare.com`) are already allow-listed —
# you do not need to paste the rotating hostname. Restart the dev server after
# changing these (`next.config` is read at boot).
# ALLOWED_DEV_ORIGINS="192.168.1.50,192.168.1.50:3000,my-app.ngrok-free.app"
# DEV_TUNNEL_HOST="my-app.ngrok-free.app"

# ---------- Object storage (S3 API) ----------
# LOCAL: MinIO from docker-compose.yml (S3-compatible)
# AWS:   remove S3_ENDPOINT (use real AWS), set region to ap-south-1,
#        and use an IAM role or access keys scoped to the bucket.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="vcfo-documents"
S3_ACCESS_KEY_ID="vcfo_minio"
S3_SECRET_ACCESS_KEY="vcfo_minio_local_dev"
S3_FORCE_PATH_STYLE="true"   # required for MinIO; set false / remove on AWS

# ---------- Email ----------
# Provider: "resend" (default) or "ses". Flip to ses only after AWS identity is verified.
EMAIL_PROVIDER="resend"
# Shared From (works for both providers). Legacy RESEND_FROM_EMAIL still works.
# Must be an address on your verified domain (e.g. sbctrack.in in Resend).
# Display name can be overridden per-send to show who initiated the mail
# (e.g. "Priya Sharma via VCFO Suite <info@sbctrack.in>").
# EMAIL_FROM="VCFO Suite <info@sbctrack.in>"
# Optional shared Reply-To / progress CC / local redirect (legacy RESEND_* aliases work).
# EMAIL_REPLY_TO="Support <support@mail.yourdomain.com>"
# EMAIL_PROGRESS_CC=""
# EMAIL_DEV_REDIRECT_TO=""

# --- Resend (default) ---
# Leave blank locally to log emails to console instead of sending.
RESEND_API_KEY=""
# Must be an address on a domain you verified in Resend (not personal Gmail/user inboxes).
# Client → lead process mail uses {company_name}@this-domain (e.g. acme-pvt-ltd@sbctrack.in)
# so leads can filter in Outlook. Tracking subdomain is for click links only.
RESEND_FROM_EMAIL="VCFO Suite <info@sbctrack.in>"
# Optional CC on client-facing progress mail (not used as a substitute for the lead).
RESEND_PROGRESS_CC=""
# Optional default Reply-To if a send path does not set one (usually unused — process
# mail sets Reply-To to the lead or client automatically).
# RESEND_REPLY_TO="Support <support@mail.yourdomain.com>"
# Optional: rewrite every outbound To/Cc to this address for local testing only.
# Do NOT set this to the client address — submit mail must reach the lead.
# RESEND_DEV_REDIRECT_TO=""
# For real multi-recipient delivery, verify a domain at resend.com/domains and
# set RESEND_FROM_EMAIL (or EMAIL_FROM) to an address on that domain (not @resend.dev).

# --- AWS SES (EMAIL_PROVIDER=ses) ---
# Verify domain/address in SES (same region). Prefer IAM role on App Runner; no keys needed then.
# SES_REGION="ap-south-1"
# SES_FROM_EMAIL="VCFO Suite <noreply@mail.yourdomain.com>"
# New SES accounts are sandboxed until you request production access.

# --- Microsoft Graph (lead → client Mail.Send) ---
# Azure app: delegated Mail.Send, User.Read, offline_access. Redirect:
#   {AUTH_URL}/api/outlook/callback
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""   # firm tenant, or "common"

# ---------- Demo auth (leave OFF) ----------
# Read by src/context/use-app-provider-value.ts. When "true" it enables a
# password-less "sign in as client" shortcut for demos. Anything other than
# "true" (including unset, the default) disables it. Do NOT enable this on a
# machine other people can reach — it hands out a client session for free.
# NEXT_PUBLIC_ENABLE_DEMO_AUTH="true"

# ---------- Uploads ----------
NEXT_PUBLIC_MAX_UPLOAD_MB="50"

# ---------- App ----------
# Used for links inside emails / Outlook redirect URI (server-side). The browser
# always uses window.location.origin. Do not pin this to a *.trycloudflare.com
# URL — those hostnames rotate. Leave as localhost or unset for tunnel demos.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- WhatsApp notifications (Twilio) ----------
# Outbound-only nudges alongside email. Email stays the system of record: if
# WhatsApp is disabled, skipped or failing, every email still sends unchanged.
#
# Leave WHATSAPP_ENABLED=false (the default) and this whole feature is inert —
# no Twilio call is made, and each attempt is recorded as `skipped/disabled`.
WHATSAPP_ENABLED=false

# Twilio console → Account Info.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Sender. Use ONE of these — a messaging service wins when both are set.
# Sandbox: whatsapp:+14155238886 (join the sandbox from each test handset first).
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_MESSAGING_SERVICE_SID=""

# Public webhook URLs. These are what Twilio SIGNS, so signature validation
# compares against these exact strings rather than rebuilding a URL from
# request headers (behind a proxy or tunnel the rebuilt host will not match).
# Point them at your tunnel host during local testing.
TWILIO_STATUS_CALLBACK_URL="https://your-host/api/webhooks/twilio/status"
TWILIO_INBOUND_CALLBACK_URL="https://your-host/api/webhooks/twilio/inbound"

# One approved Content Template SID per event (Twilio console → Content Template
# Builder). Every message body is a pre-approved template — nothing is composed
# at runtime. An event with no SID here is skipped as `no_template`.
#   welcome                  1 first name, 2 company name
#   coi_issued               1 company name
#   document_delivered       1 company name, 2 step title
#   compliance_due_monthly   1 company name, 2 obligation name, 3 due date
#   compliance_due_quarterly 1 company name, 2 obligation name, 3 due date
#   compliance_overdue       1 company name, 2 obligation name
# Variable order must match the placeholder order in the approved body.
# Never put a CIN/PAN/TAN, filing number, password, OTP or document content in
# a template variable — the message says something needs attention and links to
# the portal.
WHATSAPP_TEMPLATE_WELCOME=""
WHATSAPP_TEMPLATE_COI_ISSUED=""
WHATSAPP_TEMPLATE_DOCUMENT_DELIVERED=""
WHATSAPP_TEMPLATE_COMPLIANCE_DUE_MONTHLY=""
WHATSAPP_TEMPLATE_COMPLIANCE_DUE_QUARTERLY=""
WHATSAPP_TEMPLATE_COMPLIANCE_OVERDUE=""
