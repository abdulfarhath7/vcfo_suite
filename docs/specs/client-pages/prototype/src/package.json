  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "lucide-static": "1.55.0"
  },
  "engines": { "node": ">=18" }
}
