{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,global-error,route,template,default,opengraph-image,icon,sitemap,robots,manifest}.{ts,tsx}!",
    "scripts/**/*.{ts,mjs}!",
    "src/jobs/*.ts!",
    "src/db/schema*.ts!",
    "tests/**/*.ts",
    "src/test/*.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx,css}!",
    "src/**/*.{ts,tsx,css}!",
    "scripts/**/*.{ts,mjs}!",
    "tests/**/*.ts",
    "e2e/**/*.ts"
  ],
  "next": {
    "entry": [
      "next.config.mjs",
      "proxy.ts",
      "app/**/*.{ts,tsx}"
    ]
  },
  "vitest": {
    "config": [
      "vitest.config.mts"
    ],
    "entry": [
      "src/**/*.{test,spec}.{ts,tsx}",
      "tests/**/*.{test,spec}.{ts,tsx}"
    ]
  },
  "playwright": {
    "config": [
      "playwright.config.ts"
    ],
    "entry": [
      "e2e/**/*.spec.ts"
    ]
  },
  "drizzle": {
    "config": [
      "drizzle.config.ts"
    ]
  },
  "tailwind": {
    "config": [
      "tailwind.config.ts"
    ]
  },
  "postcss": {
    "config": [
      "postcss.config.mjs"
    ]
  },
  "eslint": {
    "config": [
      "eslint.config.mjs"
    ]
  },
  "ignoreFiles": [
    "src/components/client-portal/css-src/**"
  ],
  "ignoreDependencies": [
    "tailwindcss-animate"
  ]
}
